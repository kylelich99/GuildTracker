<Window x:Class="GuildTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GuildTracker.ViewModels"
        Title="Guild Tracker - Ragnarok Origin Classic" 
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e2e">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Dark Theme Styles -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#313244"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#b4d0fb"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#f38ba8"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#45475a"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#585b70"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#45475a"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#585b70"/>
        </Style>

        <!-- BoolToVisibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#181825" Padding="8">
            <StackPanel>
                <TextBlock Text="⚔️ Guild Tracker" FontSize="18" FontWeight="Bold" 
                           Foreground="#cba6f7" Margin="8,16,8,24" HorizontalAlignment="Center"/>
                
                <Button Content="📊 Dashboard" Style="{StaticResource NavButton}" 
                        Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                <Button Content="👥 Members" Style="{StaticResource NavButton}" 
                        Command="{Binding NavigateCommand}" CommandParameter="Members"/>
                <Button Content="📋 Attendance" Style="{StaticResource NavButton}" 
                        Command="{Binding NavigateCommand}" CommandParameter="Attendance"/>
                <Button Content="⚡ Combat Power" Style="{StaticResource NavButton}" 
                        Command="{Binding NavigateCommand}" CommandParameter="CombatPower"/>
                
                <Separator Margin="8,16" Background="#45475a"/>
                
                <Button Content="💾 Save All" Style="{StaticResource NavButton}" Command="{Binding SaveCommand}"/>
                <Button Content="📤 Export Members" Style="{StaticResource NavButton}" Command="{Binding ExportMembersCommand}"/>
                <Button Content="📤 Export Attendance" Style="{StaticResource NavButton}" Command="{Binding ExportAttendanceCommand}"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="16">
            
            <!-- Dashboard View -->
            <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource StringToVisConverter}, ConverterParameter=Dashboard}">
                <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="#cdd6f4" Margin="0,0,0,16"/>
                
                <!-- Dashboard Cards -->
                <WrapPanel>
                    <Border Style="{StaticResource CardBorder}" Width="200">
                        <StackPanel>
                            <TextBlock Text="Total Members" Foreground="#a6adc8" FontSize="12"/>
                            <TextBlock Text="{Binding TotalMembers}" Foreground="#a6e3a1" FontSize="32" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Width="200">
                        <StackPanel>
                            <TextBlock Text="Average CP" Foreground="#a6adc8" FontSize="12"/>
                            <TextBlock Text="{Binding AverageCp, StringFormat=N0}" Foreground="#89b4fa" FontSize="32" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Width="200">
                        <StackPanel>
                            <TextBlock Text="Attendance %" Foreground="#a6adc8" FontSize="12"/>
                            <TextBlock Text="{Binding AttendancePercent, StringFormat={}{0:F1}%}" Foreground="#f9e2af" FontSize="32" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Width="200">
                        <StackPanel>
                            <TextBlock Text="Absent Today" Foreground="#a6adc8" FontSize="12"/>
                            <TextBlock Text="{Binding AbsentCount}" Foreground="#f38ba8" FontSize="32" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Top CP Rankings -->
                <TextBlock Text="Top CP Rankings" FontSize="16" FontWeight="SemiBold" Foreground="#cdd6f4" Margin="0,24,0,8"/>
                <Border Style="{StaticResource CardBorder}">
                    <ItemsControl ItemsSource="{Binding FilteredMembers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding IGN}" Foreground="#cdd6f4"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Class}" Foreground="#a6adc8"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CombatPower, StringFormat=CP: {0:N0}}" Foreground="#89b4fa"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- Members View -->
            <Grid Visibility="{Binding CurrentView, Converter={StaticResource StringToVisConverter}, ConverterParameter=Members}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Member Management" FontSize="24" FontWeight="Bold" Foreground="#cdd6f4" Margin="0,0,0,12"/>

                <!-- Toolbar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Tag="Search members..."/>
                    <Button Content="+ Add Member" Style="{StaticResource ActionButton}" Margin="8,0"
                            Command="{Binding AddMemberCommand}"/>
                    <Button Content="Remove" Style="{StaticResource DangerButton}" 
                            Command="{Binding RemoveMemberCommand}"/>
                </StackPanel>

                <!-- Members DataGrid -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredMembers}" 
                          SelectedItem="{Binding SelectedMember}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="#313244" Foreground="#cdd6f4"
                          RowBackground="#313244" AlternatingRowBackground="#3b3d50"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#45475a"
                          BorderBrush="#45475a" HeadersVisibility="Column">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#181825"/>
                            <Setter Property="Foreground" Value="#cba6f7"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderBrush" Value="#45475a"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IGN" Binding="{Binding IGN}" Width="150"/>
                        <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="120"/>
                        <DataGridTextColumn Header="Combat Power" Binding="{Binding CombatPower}" Width="120"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                        <DataGridTextColumn Header="Discord ID" Binding="{Binding DiscordId}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Attendance View -->
            <Grid Visibility="{Binding CurrentView, Converter={StaticResource StringToVisConverter}, ConverterParameter=Attendance}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Attendance Tracking" FontSize="24" FontWeight="Bold" Foreground="#cdd6f4" Margin="0,0,0,12"/>

                <!-- Attendance Controls -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Event:" Foreground="#cdd6f4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="150" Text="{Binding EventName}" Margin="0,0,12,0"/>
                        <TextBlock Text="Date:" Foreground="#cdd6f4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding SelectedEventDate}" Width="140" Margin="0,0,12,0"/>
                        <Button Content="Create Event" Style="{StaticResource ActionButton}" 
                                Command="{Binding AddAttendanceEventCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mark Selected:" Foreground="#a6adc8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Present" Style="{StaticResource ActionButton}" Margin="0,0,4,0"
                                Command="{Binding MarkPresentCommand}"/>
                        <Button Content="Absent" Style="{StaticResource DangerButton}" Margin="0,0,4,0"
                                Command="{Binding MarkAbsentCommand}"/>
                        <Button Content="Late" Style="{StaticResource ActionButton}" Margin="0,0,4,0"
                                Background="#f9e2af" Command="{Binding MarkLateCommand}"/>
                        <Button Content="Partial" Style="{StaticResource ActionButton}" 
                                Background="#fab387" Command="{Binding MarkPartialCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Attendance Grid -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredMembers}" 
                          SelectedItem="{Binding SelectedMember}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          Background="#313244" Foreground="#cdd6f4"
                          RowBackground="#313244" AlternatingRowBackground="#3b3d50"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#45475a"
                          BorderBrush="#45475a">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#181825"/>
                            <Setter Property="Foreground" Value="#cba6f7"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderBrush" Value="#45475a"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IGN" Binding="{Binding IGN}" Width="150"/>
                        <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="120"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Combat Power View -->
            <Grid Visibility="{Binding CurrentView, Converter={StaticResource StringToVisConverter}, ConverterParameter=CombatPower}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Combat Power Tracking" FontSize="24" FontWeight="Bold" Foreground="#cdd6f4" Margin="0,0,0,12"/>

                <!-- CP Update Controls -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="New CP:" Foreground="#cdd6f4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="120" Text="{Binding NewCpValue}" Margin="0,0,12,0"/>
                    <Button Content="Update CP" Style="{StaticResource ActionButton}" 
                            Command="{Binding UpdateCpCommand}"/>
                    <TextBlock Text="  (Select a member first)" Foreground="#a6adc8" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Member List -->
                    <DataGrid ItemsSource="{Binding FilteredMembers}" 
                              SelectedItem="{Binding SelectedMember}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="#313244" Foreground="#cdd6f4"
                              RowBackground="#313244" AlternatingRowBackground="#3b3d50"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#45475a"
                              BorderBrush="#45475a" Margin="0,0,8,0">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#181825"/>
                                <Setter Property="Foreground" Value="#cba6f7"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="#45475a"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IGN" Binding="{Binding IGN}" Width="150"/>
                            <DataGridTextColumn Header="CP" Binding="{Binding CombatPower, StringFormat=N0}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- CP History -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="CP History" FontSize="14" FontWeight="SemiBold" Foreground="#cba6f7" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedMemberCpHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding RecordedDate, StringFormat='{}{0:MMM dd, yyyy}'}" Foreground="#a6adc8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CombatPower, StringFormat=N0}" Foreground="#89b4fa" Margin="12,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="#585b70" FontSize="10"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
