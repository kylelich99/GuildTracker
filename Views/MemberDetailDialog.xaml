<Window x:Class="GuildTracker.Views.MemberDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Member Details"
        Width="550" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e2e">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#a6adc8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Border Padding="24">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="{Binding IGN}" FontSize="22" FontWeight="Bold" Foreground="#cdd6f4"/>
                <TextBlock Text="{Binding Role}" FontSize="14" Foreground="#a6adc8" VerticalAlignment="Bottom" Margin="12,0,0,2"/>
            </StackPanel>

            <!-- Info Grid -->
            <Border Background="#313244" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Class" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding Class}" Style="{StaticResource Value}" FontWeight="SemiBold"
                                   Foreground="{Binding ClassColor}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="Combat Power" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding CombatPower, StringFormat=N0}" Style="{StaticResource Value}" Foreground="#89b4fa"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Join Date" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding JoinDate, StringFormat='{}{0:MMM dd, yyyy}'}" Style="{StaticResource Value}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="Discord ID" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding DiscordId}" Style="{StaticResource Value}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Total Absences" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding TotalAbsences}" Style="{StaticResource Value}" Foreground="#f38ba8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="MVP Awards" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding TotalMvps}" Style="{StaticResource Value}" Foreground="#f9e2af"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0">
                        <TextBlock Text="God of War" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding TotalGodOfWar}" Style="{StaticResource Value}" Foreground="#f38ba8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1">
                        <TextBlock Text="Best Support" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding TotalBestSupport}" Style="{StaticResource Value}" Foreground="#94e2d5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                        <TextBlock Text="Notes" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Value}" TextWrapping="Wrap"
                                   Foreground="#a6adc8" FontStyle="Italic"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MVP History -->
            <TextBlock Text="🏆 MVP Awards" FontSize="14" FontWeight="SemiBold" Foreground="#f9e2af" Margin="0,4,0,6"/>
            <Border Background="#313244" CornerRadius="8" Padding="12" Margin="0,0,0,12" MaxHeight="120">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MvpHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="#f9e2af" Margin="0,1">
                                    <Run Text="{Binding EventName}"/> — <Run Text="{Binding EventDate, StringFormat='{}{0:MMM dd}'}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Absence History - Selectable with clear options -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                <TextBlock Text="✗ Absence History" FontSize="14" FontWeight="SemiBold" Foreground="#f38ba8"/>
                <TextBlock Text="{Binding TotalAbsences, StringFormat=' ({0})'}" FontSize="14" Foreground="#f38ba8"/>
            </StackPanel>
            <Border Background="#313244" CornerRadius="8" Padding="12" Margin="0,0,0,8" MaxHeight="180">
                <ListBox x:Name="AbsenceList" ItemsSource="{Binding AbsenceHistory}" 
                         SelectionMode="Extended"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#cdd6f4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding EventName}" Foreground="#eba0ac"/>
                                <TextBlock Grid.Column="1" Text="{Binding EventDate, StringFormat='{}{0:ddd, MMM dd}'}" Foreground="#a6adc8"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="4,2"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#45475a"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Clear Selected" Click="ClearSelected_Click" Padding="12,6" Margin="0,0,8,0"
                        Background="#f38ba8" Foreground="#1e1e2e" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#eba0ac"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Clear All Absences" Click="ClearAll_Click" Padding="12,6"
                        Background="#45475a" Foreground="#f38ba8" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#585b70"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Close -->
            <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" Padding="16,8"
                    Background="#45475a" Foreground="#cdd6f4" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#585b70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
